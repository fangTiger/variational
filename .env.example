# 两套独立账户配置（真实值放 .env，勿入库）

# ============ farm 对冲账户（X10_*）============
# tools/hedge.py、tools/run_hedge_bot.py 用这套
X10_CLIENT_CONFIG_NAME=MAINNET
X10_API_KEY=
X10_PUBLIC_KEY=0x
X10_PRIVATE_KEY=0x
X10_VAULT_ID=

# ============ 网格账户（X10_GRID_*）============
# tools/run_grid.py 默认用这套，与 farm 完全独立、互不影响
# 需在 Extended 新建一个子账户/账户，单独入金，填入其凭证
X10_GRID_CLIENT_CONFIG_NAME=MAINNET
X10_GRID_API_KEY=
X10_GRID_PUBLIC_KEY=0x
X10_GRID_PRIVATE_KEY=0x
X10_GRID_VAULT_ID=

# ============ Variational（farm 的另一腿）============
VARIATIONAL_COOKIE=
VARIATIONAL_WALLET_ADDRESS=0x
VARIATIONAL_USER_AGENT=

# ============ RH 积分对冲账户（X10_HEDGE_*）============
# tools/run_lighter_hedge.py 用这套。必须是 Extended 上全新的子账户，
# 不能复用 X10_GRID（网格实盘中），否则对冲腿持仓会被 grid_engine 当成自己的库存
X10_HEDGE_CLIENT_CONFIG_NAME=MAINNET
X10_HEDGE_API_KEY=
X10_HEDGE_PUBLIC_KEY=0x
X10_HEDGE_PRIVATE_KEY=0x
X10_HEDGE_VAULT_ID=

# ============ Lighter @ Robinhood Chain（primary 只读腿）============
# 只需地址，不需要私钥或 API Key：机器人在 Lighter 侧只读公开端点
LIGHTER_RH_L1_ADDRESS=0x
