# 两套独立账户配置（真实值放 .env，勿入库）

# ============ farm 对冲账户（X10_*）============
# tools/hedge.py、tools/run_hedge_bot.py 用这套
X10_CLIENT_CONFIG_NAME=MAINNET
X10_API_KEY=
X10_PUBLIC_KEY=0x
X10_PRIVATE_KEY=0x
X10_VAULT_ID=

# ============ 网格账户（X10_GRID_*）============
# tools/run_grid.py 默认用这套，与 farm 完全独立、互不影响
# 需在 Extended 新建一个子账户/账户，单独入金，填入其凭证
X10_GRID_CLIENT_CONFIG_NAME=MAINNET
X10_GRID_API_KEY=
X10_GRID_PUBLIC_KEY=0x
X10_GRID_PRIVATE_KEY=0x
X10_GRID_VAULT_ID=

# ============ Variational（farm 的另一腿）============
VARIATIONAL_COOKIE=
VARIATIONAL_WALLET_ADDRESS=0x
VARIATIONAL_USER_AGENT=
